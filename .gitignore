venv/
__pycache__/
*.pyc
.env
data/chroma_db/
data/clinic.db

# Reference documents are excluded by default and allow-listed, so a copyrighted PDF
# added later cannot be committed by accident. WHO publications may be redistributed;
# GINA, GOLD and NICE are not. Every gitignored source carries a download URL in
# data/references/sources.json so a fresh clone knows what to fetch.
data/references/*.pdf
!data/references/WHO_*.pdf

# Documents a physician added through the application. Excluded wholesale rather than by
# extension: these arrive from a file picker, so nobody reviewed their licence, and a
# clinic's internal protocol is not ours to publish either. The registry goes with them —
# it names files a clone would not have.
data/references/added/

# Third-party datasets used to verify our transcription of a published scale. Excluded
# for the same reason the reference PDFs are: nobody here owns them, and this repository
# holds no patient records - claimed-anonymised or otherwise. data/verification/sources.json
# names each one and where to download it.
data/verification/*.csv
