# The front end's configuration. Copy to `web/.env`; that file is gitignored.
#
# Both settings have working defaults, so the site runs with no `.env` at all. They exist
# so that moving a service is a configuration change rather than a code change.

# What the browser calls.
#
# `/api` is a relative path, which means the request goes to whatever host is serving the
# page and the dev server proxies it on to Laravel (see VITE_API_PROXY_TARGET). Browser and
# API share an origin, so there is no CORS to configure and the token is not sent cross-site.
#
# Set this to an absolute URL — e.g. https://api.example.org/api — when the front end and the
# backend are deployed to different hosts. That makes requests cross-origin, so Laravel then
# needs CORS configured and the front end's origin added to `api/config/sanctum.php`.
VITE_API_URL=/api

# Where the dev server forwards `/api` to. Development only: the built site in `web/dist`
# has no proxy, so for a real deployment set VITE_API_URL above instead.
# Must match the address `php artisan serve` is listening on.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
