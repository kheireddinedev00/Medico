OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
CHROMA_PERSIST_DIR=data/chroma_db
DB_PATH=data/clinic.db
CONTEXT_RECENT_VISITS=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VLM_MODEL=google/gemma-4-31b-it:free
# --- Triage agent ---
# Defaults to OPENROUTER_MODEL. Set TRIAGE_RULES_ONLY=1 to run the agent with no model
# at all, which is a supported mode, not a broken one.
TRIAGE_MODEL=google/gemma-4-31b-it:free
TRIAGE_LLM_TIMEOUT=20
TRIAGE_LLM_RETRIES=1
TRIAGE_RULES_ONLY=0
VLM_MAX_TOKENS=8192
PDF_RENDER_DPI=200
MIN_IMAGE_LONG_EDGE=1600

# --- HTTP service (service/app.py) ---
# Shared secret the Laravel backend must send as X-Service-Key.
# Empty means no check, which is only safe if the port is bound to localhost.
SERVICE_API_KEY=
