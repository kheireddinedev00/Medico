<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Never let a test run read the cached configuration.

             The application caches its config so that Apache's worker threads do not each
             parse `.env` (see the README — racing that parse under a threaded MPM is what
             made one request in eighty fall back to framework defaults). But a cached
             config also outranks every `<env>` below it, including the database name — and
             these tests use RefreshDatabase, so a test run would have migrated the clinic's
             own database from scratch instead of the test one.

             Pointing the cache at a path that is never written keeps the values here
             authoritative. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing-never-written.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The same engine the application runs on. In-memory SQLite is faster, but a
             suite that passes against a database nobody deploys is testing the wrong
             thing: SQLite is typeless and accepts values MySQL rejects, and its `=` is
             case-sensitive where MySQL's collation is not. Its own database, so a test
             run never touches the clinic's data. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="respiratory_cdss_test"/>
        <env name="DB_URL" value=""/>
        <!-- Host and credentials deliberately absent: they fall through to `.env`, which
             is not in the repository. Only the database name is overridden, which is the
             part that matters — it is what keeps a test run off the clinic's data. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Triage without the model. The deterministic layers decide the priority, so the
             assertions are unchanged; what goes away is a live free-tier call per test and
             the flakiness that comes with it. -->
        <env name="ENGINE_TRIAGE_RULES_ONLY" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
